{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ink Writer M0",
  "version": "0.0.0",
  "identifier": "dev.inkwriter.m0",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ink Writer · Prototipo M0",
        "width": 1100,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
