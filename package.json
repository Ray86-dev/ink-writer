{
  "name": "ink-writer",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w @ink-writer/desktop -- dev",
    "build:debug": "npm run tauri -w @ink-writer/desktop -- build --debug --no-bundle",
    "smoke": "node scripts/smoke.mjs",
    "check": "biome check . && npm run typecheck --workspaces",
    "test": "npm run test:ts && npm run test:rust",
    "test:ts": "vitest run",
    "pretest:rust": "npm run build:web -w @ink-writer/desktop",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "precheck:rust": "npm run build:web -w @ink-writer/desktop",
    "check:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "licenses": "node scripts/check-licenses.mjs",
    "fixtures": "node fixtures/validate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
